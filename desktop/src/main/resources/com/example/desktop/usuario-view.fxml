<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.desktop.controllers.UsuarioController">
    <children>
      <Label layoutX="135.0" layoutY="109.0" text="Nome" />
      <TextField fx:id="txtNome" layoutX="195.0" layoutY="105.0" prefHeight="25.0" prefWidth="186.0" />
      <Label layoutX="135.0" layoutY="149.0" text="Email" />
      <TextField fx:id="txtEmail" layoutX="195.0" layoutY="145.0" prefHeight="25.0" prefWidth="186.0" />
      <Label layoutX="135.0" layoutY="192.0" text="Senha" />
      <PasswordField fx:id="txtSenha" layoutX="195.0" layoutY="188.0" prefHeight="25.0" prefWidth="186.0" />
        <Button layoutX="14.0" layoutY="351.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="97.0" text="Voltar" onAction="#onVoltarButtonClick"/>
        <Button layoutX="465.0" layoutY="351.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="121.0" text="Salvar" onAction="#onSalvarButtonClick"/>

    </children>
</AnchorPane>
